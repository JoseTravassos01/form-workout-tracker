{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/vitest-pool-workers/types", "@cloudflare/workers-types", "vitest/globals"],
    "noEmit": true
  },
  "include": ["tests", "worker", "shared", "worker-configuration.d.ts"]
}
