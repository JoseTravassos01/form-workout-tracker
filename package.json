{
  "name": "form-workout-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "node scripts/build-cloudflare-env.mjs dev",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dev": "npm run build:dev && wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:migrate:local": "wrangler d1 migrations apply form-workout-tracker-prod-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply form-workout-tracker-prod-db --remote",
    "db:migrate:dev": "wrangler d1 migrations apply form-workout-tracker-dev-db --remote --env dev",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/seed.ts --remote",
    "check:ci": "npm run cf-typegen && npm run typecheck && npm run lint && npm run test",
    "check": "npm run cf-typegen && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "idb": "8.0.3",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "5.20260813.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
